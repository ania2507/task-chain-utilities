<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="sortSettingsDialog"
        title="{i18n>common.settings}"
        contentWidth="30rem"
        resizable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <SegmentedButton selectedKey="{sortSettings>/tab}" class="sapUiSmallMarginBottom">
                    <items>
                        <SegmentedButtonItem key="sort" text="{i18n>sort.title}"/>
                        <SegmentedButtonItem key="group" text="{i18n>group.title}"/>
                    </items>
                </SegmentedButton>

                <!-- Sort tab -->
                <VBox visible="{= ${sortSettings>/tab} === 'sort'}">
                    <HBox justifyContent="End" class="sapUiTinyMarginBottom">
                        <Link text="{i18n>sort.reset}" press=".onSortReset"/>
                    </HBox>
                    <List id="sortCriteriaList" items="{path: 'sortSettings>/criteria', templateShareable: false}">
                        <CustomListItem>
                            <HBox alignItems="Center" class="sapUiTinyMarginTop sapUiTinyMarginBottom sapUiTinyMarginBegin">
                                <Select selectedKey="{sortSettings>key}" width="11rem" class="sapUiTinyMarginEnd"
                                    change=".onSortCriterionChange"
                                    items="{path: 'sortSettings>options', templateShareable: false}">
                                    <core:Item key="{sortSettings>key}" text="{sortSettings>text}"/>
                                </Select>
                                <SegmentedButton selectedKey="{= ${sortSettings>descending} ? 'desc' : 'asc'}"
                                    selectionChange=".onSortDirectionChange" class="sapUiTinyMarginEnd">
                                    <items>
                                        <SegmentedButtonItem key="asc" icon="sap-icon://sort-ascending" tooltip="{i18n>sort.ascending}"/>
                                        <SegmentedButtonItem key="desc" icon="sap-icon://sort-descending" tooltip="{i18n>sort.descending}"/>
                                    </items>
                                </SegmentedButton>
                                <Button icon="sap-icon://slim-arrow-up" type="Transparent"
                                    enabled="{sortSettings>canMoveUp}" press=".onSortMoveUp" tooltip="{i18n>sort.moveUp}"/>
                                <Button icon="sap-icon://slim-arrow-down" type="Transparent"
                                    enabled="{sortSettings>canMoveDown}" press=".onSortMoveDown" tooltip="{i18n>sort.moveDown}"/>
                                <Button icon="sap-icon://decline" type="Transparent"
                                    enabled="{sortSettings>canRemove}" press=".onSortRemoveCriterion" tooltip="{i18n>sort.remove}"/>
                            </HBox>
                        </CustomListItem>
                    </List>
                    <Button text="{i18n>sort.addCriterion}" icon="sap-icon://add" type="Transparent"
                        press=".onSortAddCriterion" class="sapUiTinyMarginTop"
                        enabled="{= ${sortSettings>/criteria}.length &lt; ${sortSettings>/maxCriteria} }"/>
                </VBox>

                <!-- Group tab -->
                <VBox visible="{= ${sortSettings>/tab} === 'group'}">
                    <Label text="{i18n>group.by}" class="sapUiTinyMarginBottom"/>
                    <RadioButtonGroup id="groupByRadioGroup" columns="1" selectedIndex="{sortSettings>/groupIndex}">
                        <RadioButton text="{i18n>group.none}"/>
                        <RadioButton text="{i18n>col.space}"/>
                        <RadioButton text="{i18n>col.folder}"/>
                        <RadioButton text="{i18n>col.type}"/>
                    </RadioButtonGroup>
                </VBox>
            </VBox>
        </content>
        <buttons>
            <Button text="{i18n>common.ok}" type="Emphasized" press=".onSortApply"/>
            <Button text="{i18n>common.cancel}" press=".onSortCancel"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
