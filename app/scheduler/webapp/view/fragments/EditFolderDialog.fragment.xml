<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="editFolderPopover"
        title="Tag"
        placement="Bottom"
        contentWidth="20rem">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Group this task chain under a tag" labelFor="editFolderSelect" class="sapUiTinyMarginBottom"/>
                <Select id="editFolderSelect"
                        selectedKey="{folderEdit>/value}"
                        forceSelection="false"
                        items="{path: 'folderEdit>/suggestions', templateShareable: false}">
                    <core:Item key="{folderEdit>key}" text="{folderEdit>text}"/>
                </Select>
                <Text text="No tags yet — create one from &quot;Manage Tags&quot; first." class="sapUiTinyMarginTop"
                      visible="{= ${folderEdit>/suggestions}.length &lt;= 1}"/>
            </VBox>
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button text="{i18n>common.cancel}" press=".onEditFolderCancel"/>
                <Button text="{i18n>common.save}" type="Emphasized" press=".onEditFolderSave"/>
            </OverflowToolbar>
        </footer>
    </ResponsivePopover>
</core:FragmentDefinition>
