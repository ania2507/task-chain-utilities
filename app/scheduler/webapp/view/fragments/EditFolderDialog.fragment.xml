<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="editFolderPopover"
        title="Tag"
        placement="Bottom"
        contentWidth="20rem">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Group this task chain under a tag" labelFor="editFolderInput" class="sapUiTinyMarginBottom"/>
                <Input id="editFolderInput"
                       value="{folderEdit>/value}"
                       placeholder="e.g. Project X"
                       showSuggestion="true"
                       suggestionItems="{folderEdit>/suggestions}"
                       submit=".onEditFolderSave">
                    <suggestionItems>
                        <core:Item text="{folderEdit>text}"/>
                    </suggestionItems>
                </Input>
            </VBox>
        </content>
        <footer>
            <OverflowToolbar>
                <Button text="Clear" press=".onEditFolderClear" visible="{= !!${folderEdit>/current} }"/>
                <ToolbarSpacer/>
                <Button text="{i18n>common.cancel}" press=".onEditFolderCancel"/>
                <Button text="{i18n>common.save}" type="Emphasized" press=".onEditFolderSave"/>
            </OverflowToolbar>
        </footer>
    </ResponsivePopover>
</core:FragmentDefinition>
