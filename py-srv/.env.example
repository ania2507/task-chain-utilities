# Local development environment for py-srv
# Copy to py-srv/.env (git-ignored) and fill in values.

# Disable JWT validation for local testing (never set in production)
SKIP_AUTH=true

# Use in-memory store instead of HANA (quick smoke test without DB)
# USE_IN_MEMORY_REPO=true

# Expose diagnostic endpoints (GET /v1/dsp/debug-*, GET /v1/jobs/ibp/debug-conn,
# and the _debug_* keys in POST /v1/jobs/ibp/template-steps). Off by default -
# these leak internal metadata and should stay disabled outside local debugging.
# ENABLE_DEBUG_ENDPOINTS=true

# Destination Service OAuth client, used as local-dev fallback by the dsp/sac/ibp
# integrations when no VCAP_SERVICES destination binding is present (on CF this
# comes from the platform automatically).
DEST_SERVICE_URL=https://<subaccount>.dest.<region>.hana.ondemand.com
DEST_TOKEN_URL=https://<subaccount>.authentication.<region>.hana.ondemand.com/oauth/token
DEST_CLIENT_ID=sb-<xsappname>!b<instance>|destination-xsappname!b<id>
DEST_CLIENT_SECRET=<client-secret>

DSP_DESTINATION_NAME=External_Trigger_DSP
DSP_SIMULATE=false

# DSP HANA cross-schema access (on CF these come from the dsp-hana UPS via VCAP_SERVICES)
DSP_HANA_HOST=<uuid>.hana.prod-eu30.hanacloud.ondemand.com
DSP_HANA_PORT=443
DSP_HANA_USER=DWCDBUSER#<schema>
DSP_HANA_PASSWORD=<password>

# ── IBP Integration (Application Jobs via OData) ──
IBP_DESTINATION_NAME=IBP_APPJOB_MANAGEMENT
# Direct fallback, bypassing the Destination Service:
# IBP_HOST=https://<tenant>-api.scmibp1.ondemand.com
# IBP_USER=<communication-user>
# IBP_PASSWORD=<password>
# IBP_VERIFY_SSL=true

# ── SAC Integration (Multi Actions via REST) ──
SAC_DESTINATION_NAME=SAC_DSP_ORCHESTRATOR
# Direct fallback, bypassing the Destination Service:
# SAC_HOST=https://<tenant>.<region>.sapanalytics.cloud
# SAC_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
# SAC_CLIENT_ID=sb-<xsappname>!b<instance>|client!b<id>
# SAC_CLIENT_SECRET=<client-secret>
# SAC_VERIFY_SSL=true
